# PROJI frontend environment. Copy to .env.local — never commit real values.
# Use ONLY the PROJI Supabase project (never RightMix).
VITE_SUPABASE_URL=https://<proji-project-ref>.supabase.co
# Publishable/anon key only. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=<proji-publishable-key>
